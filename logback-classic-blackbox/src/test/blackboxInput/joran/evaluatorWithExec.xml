<!-- CVE-2024-12798: the Janino expressions below must never be compiled nor executed -->
<configuration>

  <evaluator name="execEval">
    <expression>System.setProperty("logback.blackbox.janinoEvaluatorExec", "evaluator") == null</expression>
  </evaluator>

  <appender name="STR_LIST" class="ch.qos.logback.core.testUtil.StringListAppender">
    <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
      <OnMatch>DENY</OnMatch>
      <evaluator>
        <expression>System.setProperty("logback.blackbox.janinoEvaluatorExec", "filter") == null</expression>
      </evaluator>
    </filter>
    <layout>
      <Pattern>%caller{1, execEval}%level - %m%n</Pattern>
    </layout>
  </appender>

  <root level="DEBUG">
    <appender-ref ref="STR_LIST" />
  </root>
</configuration>
